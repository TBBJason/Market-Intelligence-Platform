# Application
MI_ENVIRONMENT=development
MI_LOG_LEVEL=INFO
MI_DATABASE_URL=postgresql+psycopg://market_intelligence:market_intelligence@localhost:5432/market_intelligence
MI_GITHUB_API_URL=https://api.github.com
MI_GITHUB_TOKEN=
MI_GITHUB_TOKEN_HOST=api.github.com
MI_GITHUB_TOKEN_PORT=443
MI_HTTP_USER_AGENT="ai-infrastructure-market-intelligence/0.1 (contact: YOUR_EMAIL)"
MI_HTTP_TIMEOUT_SECONDS=20
MI_HTTP_MAX_ATTEMPTS=3
MI_HTTP_MAX_RETRY_AFTER_SECONDS=60
MI_HTTP_MAX_RESPONSE_BYTES=2000000

# PostgreSQL container (local development only)
POSTGRES_DB=market_intelligence
POSTGRES_USER=market_intelligence
POSTGRES_PASSWORD=market_intelligence

# dbt uses these separately so profiles.yml contains no credentials
DBT_HOST=localhost
DBT_PORT=5432
DBT_USER=market_intelligence
DBT_PASSWORD=market_intelligence
DBT_DATABASE=market_intelligence
DBT_SCHEMA=dev
DBT_THREADS=4
